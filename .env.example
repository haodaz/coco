# Meta Model API key (dev.meta.ai). META_API_KEY also works.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# 1 = call the real API. Anything else = practice mode: sample answers, nothing leaves the machine.
META_LIVE=0
# Hosted mode (optional): Supabase project keys. Without them everything stays in data/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Emails with no daily limits, comma-separated
ADMIN_EMAILS=
# Site-wide cap on paintings per day
SITE_PAINTINGS_PER_DAY=500
